# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor
PORT=3000

# Secreto para firmar la cookie de sesión (usa un valor largo y aleatorio)
SESSION_SECRET=cambia-este-secreto

# Credenciales del analista que se crea automáticamente al iniciar
ADMIN_USER=analista
ADMIN_PASSWORD=Analista123*

# Rutas de almacenamiento local
DB_PATH=data/practicantes.db
UPLOAD_DIR=uploads

# Tamaño máximo de la hoja de vida en MB
MAX_FILE_MB=5
