# Copia este archivo como .env y ajusta los valores.

# Puerto del servidor
PORT=3000

# Credenciales del analista que se crea automáticamente la primera vez que
# arranca el servidor. Si el usuario ya existe en la base de datos, no se modifica.
ADMIN_USER=analista
ADMIN_PASSWORD=Analista123*

# Rutas de almacenamiento local
DB_PATH=data/practicantes.db
UPLOAD_DIR=uploads

# Tamaño máximo de la hoja de vida en MB
MAX_FILE_MB=5
