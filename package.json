{
  "name": "plataforma-seleccion-practicantes",
  "version": "1.0.0",
  "description": "Reto técnico Practicante FullStack 2027-I: registro de practicantes y panel de analistas de selección.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "jest",
    "seed": "node --env-file-if-exists=.env scripts/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "author": "Carlos Alejandro Cadena",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
